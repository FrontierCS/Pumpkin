#!/bin/sh
# A stand-in for the `docker` command line, which the tests of the EC2 and Modal providers find on
# `PATH` beside the stand-in `aws`, through a link to it, named `docker`, in a directory of their
# own. For a test that publishes nothing, the provider reaches an engine through it without Docker:
# it answers the three commands that reach one, as Docker's command line would, of the version in
# that directory's `docker-version`, if there is one, and fails any other. If that directory holds a
# file named `engine`, as a test that publishes makes it, it runs Docker's own command line instead,
# the next `docker` on `PATH`, and records each call in `calls`, as the stand-in `aws` does.
dir=${0%/*}
if [ -e "$dir/engine" ]; then
    case $PATH in
    "$dir":*) PATH=${PATH#"$dir":} ;;
    *)
        echo "the stand-in docker can't find Docker's own: \`PATH\` doesn't name $dir first" >&2
        exit 1 ;;
    esac
    { echo docker; printf '%s\n' "$@"; echo; } >>"$dir/calls"
    exec docker "$@"
fi
while [ "${1#--}" != "$1" ]; do shift; done
case "$1 $2" in
"context inspect")
    echo unix:///nonexistent/docker-stand-in.sock ;;
"info --format")
    version=$(cat "$dir/docker-version" 2>/dev/null || echo 29.9.2)
    echo '{"MemoryLimit": true, "SwapLimit": true, "CpuCfsQuota": true, "CPUSet": true, "PidsLimit": true, "MemTotal": 8589934592, "ID": "stand-in", "DriverStatus": [["driver-type", "io.containerd.snapshotter.v1"]], "SecurityOptions": ["name=seccomp,profile=builtin"], "KernelVersion": "7.0.0", "OperatingSystem": "stand-in", "ServerVersion": "29.9.2", "ClientInfo": {"Version": "'"$version"'"}}' ;;
"version --format")
    echo linux/amd64 ;;
*)
    echo "the stand-in docker doesn't know \`$*\`" >&2
    exit 1 ;;
esac
