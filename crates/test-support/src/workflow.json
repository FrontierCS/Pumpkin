{
  "ir_version": "pumpkin.ir/v0",
  "name": "example/task",
  "roles": [
    {
      "name": "agent",
      "image": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "user": { "uid": 10001, "gid": 10001 },
      "needs": {
        "cpu_millis": 8000,
        "memory_bytes": 34359738368
      },
      "runtime": {
        "agent": {
          "command": {
            "argv": ["/usr/local/bin/pumpkin-fake-agent"],
            "cwd": "/workspace"
          },
          "dirs": [
            { "path": "/workspace/.codex", "mode": "0700" },
            { "path": "/workspace/.tmp", "mode": "0700" }
          ],
          "files": [
            {
              "path": "/workspace/.codex/config.toml",
              "mode": "0600",
              "content": "model = \"gpt-6-astra\"\n"
            }
          ],
          "stdin": "Solve the task in /task/README.md.\n",
          "deadline_seconds": 18000,
          "finalize_grace_seconds": 60,
          "egress": {
            "model": [{ "api": "responses", "models": ["gpt-6-astra"] }]
          },
          "grants": [
            {
              "name": "train",
              "job": {
                "target": "trainer",
                "body": { "file": "//lib/train.star", "def": "train" },
                "payload_max_bytes": 4194304,
                "calls": 100,
                "cumulative_seconds": 12000,
                "call_timeout_seconds": 12000
              }
            },
            {
              "name": "submit",
              "now": {
                "body": {
                  "file": "//task.star",
                  "def": "submit",
                  "arguments": { "finalize": { "type": "bool", "default": false } }
                },
                "payload_max_bytes": 4194304
              }
            }
          ]
        }
      }
    },
    {
      "name": "trainer",
      "image": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "user": { "uid": 65532, "gid": 65532 },
      "needs": {
        "cpu_millis": 8000,
        "memory_bytes": 2147483648
      },
      "runtime": {
        "target": {
          "cwd": "/workspace",
          "env": ["MODE=train", "DATASET=/data/train.json"]
        }
      }
    },
    {
      "name": "final_judge",
      "image": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "user": { "uid": 65532, "gid": 65532 },
      "needs": {
        "cpu_millis": 8000,
        "memory_bytes": 2147483648
      },
      "runtime": {
        "judge": {
          "command": {
            "argv": ["/usr/local/bin/judge"],
            "cwd": "/pumpkin/home",
            "env": [
              "MODE=eval",
              "DATASET=/data/eval.json"
            ]
          },
          "slots": [{ "name": "payload", "max_bytes": 4194304 }],
          "result": {
            "shows": { "score": "/raw_score", "metrics": "/metrics" },
            "returns": ["/raw_score", "/metrics", "/failure"]
          }
        }
      }
    }
  ],
  "score": { "role": "final_judge", "slot": "payload", "timeout_seconds": 120 }
}
