{
  "ir_version": "pumpkin.ir/v0",
  "name": "example/task",
  "roles": [
    {
      "name": "agent",
      "image": "example/agent@sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "user": { "uid": 10001, "gid": 10001 },
      "needs": {
        "cpu_millis": 8000,
        "memory_bytes": 34359738368
      },
      "runtime": {
        "agent": {
          "command": {
            "argv": ["/usr/local/bin/pumpkin-fake-agent"],
            "cwd": "/workspace"
          },
          "dirs": [
            { "path": "/workspace/.codex", "mode": "0700" },
            { "path": "/workspace/.tmp", "mode": "0700" }
          ],
          "files": [
            {
              "path": "/workspace/.codex/config.toml",
              "mode": "0600",
              "content": "model = \"gpt-6-astra\"\n"
            }
          ],
          "stdin": "Solve the task in /task/README.md.\n",
          "deadline_seconds": 18000,
          "finalize_grace_seconds": 60
        }
      },
      "egress": {
        "model": { "models": ["gpt-6-astra"] }
      },
      "grants": [
        {
          "judge": {
            "name": "train",
            "role": "train_judge",
            "slot": "payload",
            "calls": 100,
            "cumulative_seconds": 12000,
            "call_timeout_seconds": 12000
          }
        },
        { "submit": { "name": "submit" } }
      ]
    },
    {
      "name": "train_judge",
      "image": "example/judge@sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "user": { "uid": 65532, "gid": 65532 },
      "needs": {
        "cpu_millis": 8000,
        "memory_bytes": 2147483648
      },
      "runtime": {
        "judge": {
          "command": {
            "argv": ["/usr/local/bin/judge"],
            "cwd": "/pumpkin/home",
            "env": [
              "MODE=train",
              "DATASET=/data/train.json"
            ]
          },
          "slots": [{ "name": "payload", "max_bytes": 4194304 }],
          "result": {
            "score": "/raw_score",
            "returns": ["/raw_score", "/metrics", "/failure"]
          }
        }
      }
    },
    {
      "name": "final_judge",
      "image": "example/judge@sha256:2222222222222222222222222222222222222222222222222222222222222222",
      "user": { "uid": 65532, "gid": 65532 },
      "needs": {
        "cpu_millis": 8000,
        "memory_bytes": 2147483648
      },
      "runtime": {
        "judge": {
          "command": {
            "argv": ["/usr/local/bin/judge"],
            "cwd": "/pumpkin/home",
            "env": [
              "MODE=eval",
              "DATASET=/data/eval.json"
            ]
          },
          "slots": [{ "name": "payload", "max_bytes": 4194304 }],
          "result": {
            "score": "/raw_score",
            "returns": ["/raw_score", "/metrics", "/failure"]
          }
        }
      }
    }
  ],
  "score": { "role": "final_judge", "slot": "payload", "timeout_seconds": 120 }
}
