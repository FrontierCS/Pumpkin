// The type check of the page's script, which `cargo xtask ci` runs. The script stays plain
// JavaScript that the browser loads as it is; the types are in its JSDoc comments.
{
  "compilerOptions": {
    // Check the JavaScript itself, and write nothing.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // A value that may be null or undefined must be checked before use: the server's JSON holds
    // many such fields. The rest of `strict` would ask a type of every parameter, most of which
    // say nothing that their use doesn't.
    "strict": false,
    "strictNullChecks": true,
    // What the browsers that open the page run, as modules.
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  "files": ["scheme.js", "app.js"]
}
