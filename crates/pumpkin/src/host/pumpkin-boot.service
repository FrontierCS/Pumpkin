[Unit]
Description=Remove what lost Pumpkin runs left
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
# The files that each build's boot makes are readable by its user alone.
UMask=0077
ExecStart=@ADMIN@ boot-all

[Install]
WantedBy=multi-user.target
