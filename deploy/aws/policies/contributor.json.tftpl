{
  "Statement": [
    {
      "Action": [
        "ec2:StartInstances"
      ],
      "Effect": "Allow",
      "Resource": [
        "${controller_instance_arn}"
      ]
    },
    {
      "Action": [
        "iam:GetInstanceProfile"
      ],
      "Effect": "Allow",
      "Resource": [
        "${controller_profile_arn}"
      ]
    },
    {
      "Action": [
        "iam:SimulatePrincipalPolicy"
      ],
      "Effect": "Allow",
      "Resource": [
        "${controller_role_arn}",
        "${modal_pull_role_arn}",
        "${sandbox_role_arn}",
        "${timer_role_arn}"
      ]
    },
    {
      "Action": [
        "ssm:GetParameter"
      ],
      "Effect": "Allow",
      "Resource": [
        "${members_parameter_arn}"
      ]
    },
    {
      "Action": [
        "iam:GetInstanceProfile"
      ],
      "Effect": "Allow",
      "Resource": [
        "${sandbox_profile_arn}"
      ]
    },
    {
      "Action": [
        "ssm:GetParameter"
      ],
      "Effect": "Allow",
      "Resource": [
        "${settings_parameter_arn}"
      ]
    },
    {
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeLaunchTemplateVersions",
        "scheduler:ListSchedules"
      ],
      "Effect": "Allow",
      "Resource": [
        "*"
      ]
    }
  ],
  "Version": "2012-10-17"
}
