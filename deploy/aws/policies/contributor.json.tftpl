{
  "Statement": [
    {
      "Action": [
        "ec2:StartInstances"
      ],
      "Effect": "Allow",
      "Resource": [
        "${controller_instance_arn}"
      ]
    },
    {
      "Action": [
        "ec2-instance-connect:OpenTunnel"
      ],
      "Condition": {
        "IpAddress": {
          "ec2-instance-connect:privateIpAddress": [
            "${controller_private_ip}"
          ]
        },
        "NumericEquals": {
          "ec2-instance-connect:remotePort": [
            "22"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": [
        "${instance_connect_endpoint_arn}"
      ]
    },
    {
      "Action": [
        "ssm:GetParameter"
      ],
      "Effect": "Allow",
      "Resource": [
        "${members_parameter_arn}"
      ]
    },
    {
      "Action": [
        "iam:GetInstanceProfile"
      ],
      "Effect": "Allow",
      "Resource": [
        "${sandbox_profile_arn}"
      ]
    },
    {
      "Action": [
        "ssm:GetParameter"
      ],
      "Effect": "Allow",
      "Resource": [
        "${settings_parameter_arn}"
      ]
    },
    {
      "Action": [
        "ec2:DescribeInstanceConnectEndpoints",
        "ec2:DescribeInstances",
        "ec2:DescribeLaunchTemplateVersions",
        "iam:GetInstanceProfile",
        "iam:SimulatePrincipalPolicy",
        "scheduler:ListSchedules"
      ],
      "Effect": "Allow",
      "Resource": [
        "*"
      ]
    }
  ],
  "Version": "2012-10-17"
}
