{
  "Statement": [
    {
      "Action": [
        "ec2:StartInstances"
      ],
      "Effect": "Allow",
      "Resource": [
        "${controller_instance_arn}"
      ]
    },
    {
      "Action": [
        "ssm:GetParameter"
      ],
      "Effect": "Allow",
      "Resource": [
        "${host_key_parameter_arn}"
      ]
    },
    {
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Effect": "Allow",
      "Resource": [
        "*"
      ]
    }
  ],
  "Version": "2012-10-17"
}
