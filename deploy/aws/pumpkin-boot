#!/bin/sh
umask 077
exec >> "$HOME/boot.log" 2>&1
failed=''
for boot in "$HOME"/.pumpkin/*/bin/pumpkin-boot; do
    [ -e "$boot" ] || [ -L "$boot" ] || continue
    "$boot" controller boot || failed="$failed $boot (exit $?)"
done
if [ -n "$failed" ]; then
    printf 'controller boot failed for%s\n' "$failed"
    exit 1
fi
